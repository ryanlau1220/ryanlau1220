{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  // Local secrets belong in .dev.vars; production setup is documented in SETUP.md.
  "main": "./src/server.ts",
  // Lets src/routes/resume.ts read public/ files; the Vite plugin fills in the directory.
  "assets": {
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "VISITOR_LOG_DB",
      "database_name": "portfolio-visitor-log",
      "database_id": "9f5d850e-4b4c-4ce7-ba99-29450d22f933"
    }
  ],
  // Workers Logs: keeps request logs, console output, and errors for 7 days, searchable in the
  // dashboard (Workers > this Worker > Observability). On the Free plan Cloudflare simply stops
  // storing once the daily allowance is used; on Paid, usage beyond the included amount is billed.
  // Lower head_sampling_rate (1 = every request) if traffic ever grows.
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // Public, non-secret values. Local .dev.vars overrides them during `pnpm dev`.
  "vars": {
    "SITE_URL": "https://ryanlau1220.dev",
    "DIARY_URL": "https://diary.ryanlau1220.dev",
    "CF_ANALYTICS_TOKEN": "97289c376353402a80a5366c9ece5508",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAD5OBIUxwrQ_UYo-",
    "VISITOR_LOG_HOSTNAME": "ryanlau1220.dev,portfolio.ryanlau1220.workers.dev"
  }
}
