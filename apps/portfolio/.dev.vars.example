# Local-only settings. Copy to .dev.vars and replace every value.
# Never commit apps/portfolio/.dev.vars.

# Public origins. Production values live under "vars" in wrangler.jsonc.
SITE_URL="http://localhost:3000"
DIARY_URL="http://localhost:3001"
# Leave empty to skip Cloudflare Web Analytics locally.
CF_ANALYTICS_TOKEN=""

TURNSTILE_SITE_KEY="your-local-turnstile-site-key"
TURNSTILE_SECRET_KEY="your-local-turnstile-secret-key"
VISITOR_LOG_RATE_LIMIT_SALT="a-unique-random-local-salt"
VISITOR_LOG_HOSTNAME="localhost,127.0.0.1"

# Optional: use a separate Pusher app for development. Leave all four unset to disable realtime locally.
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER=""
