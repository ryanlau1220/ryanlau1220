{
  "name": "ryanlau1220-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome check . --error-on-warnings",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "pnpm run lint && turbo run typecheck test build",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "turbo": "^2.3.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
