{
  "name": "diary-app",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3001",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --config tests/vitest.config.ts",
    "test:e2e": "pnpm run build && playwright test",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DIARY_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DIARY_DB --remote",
    "seed:local": "node scripts/seed.mjs --local",
    "seed:remote": "node scripts/seed.mjs --remote"
  },
  "dependencies": {
    "@cf-wasm/og": "^0.5.0",
    "@cloudflare/vite-plugin": "^1.26.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "1.170.17",
    "@tanstack/react-start": "1.168.27",
    "better-auth": "^1.3.27",
    "drizzle-orm": "^0.45.4",
    "gsap": "^3.15.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tanstack/router-plugin": "1.168.18",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5",
    "wrangler": "^4.70.0"
  }
}
