{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diary",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  // Local secrets belong in .dev.vars; see .dev.vars.example and SETUP.md.
  "main": "./src/server.ts",
  // Wrangler attaches this hostname (and creates its DNS record) on deploy.
  "routes": [{ "pattern": "diary.ryanlau1220.dev", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DIARY_DB",
      "database_name": "diary",
      "database_id": "90d53c65-166c-4c08-84d9-252aa53f3bac",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "diary-photos"
    }
  ],
  // Public, non-secret values. Local .dev.vars overrides them during `pnpm dev`.
  "vars": {
    "SITE_URL": "https://diary.ryanlau1220.dev",
    "BETTER_AUTH_URL": "https://diary.ryanlau1220.dev",
    "CF_ANALYTICS_TOKEN": "0ab5adeef84e4988be00f174b9797ec6"
  }
}
