# Settings for the Playwright test server only (see playwright.config.ts). These are fake values
# that enable the owner features locally without any real GitHub app or secret. Never reuse them
# anywhere else. playwright.config.ts passes each line to wrangler as a `--var` flag, which takes
# precedence over a developer's real .dev.vars, so tests behave the same on a laptop and in CI.
SITE_URL="http://127.0.0.1:3101"
BETTER_AUTH_URL="http://127.0.0.1:3101"
BETTER_AUTH_SECRET="playwright-test-only-secret-not-for-production-use"
GITHUB_CLIENT_ID="playwright-test-client-id"
GITHUB_CLIENT_SECRET="playwright-test-client-secret-not-real"
OWNER_GITHUB_ID="424242"
