{
  "name": "portfolio-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome check .",
    "typecheck": "turbo run typecheck",
    "check": "pnpm run lint && turbo run typecheck build",
    "format": "biome format --write .",
    "db:studio": "pnpm --filter @portfolio/db db:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "turbo": "^2.3.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "lightningcss", "better-sqlite3"]
  }
}
